{
    "FunctionName": "cleanOrphanedPhotos",
    "Runtime": "python3.12",
    "Role": "arn:aws:iam::850995535850:role/dynamo-db-role",
    "Handler": "lambda_function.lambda_handler",
    "Description": "Cleans up candidatePhoto records where the S3 image no longer exists",
    "Timeout": 600,
    "MemorySize": 256,
    "Environment": {
        "Variables": {
            "BUCKET_NAME": "hrrfiles",
            "TABLE_NAME": "candidatePhoto"
        }
    }
}
