{
    "FunctionName": "deleteAllOrphanedQuestions",
    "Runtime": "python3.12",
    "Role": "arn:aws:iam::850995535850:role/dynamo-db-role",
    "Handler": "lambda_function.lambda_handler",
    "Description": "Comprehensive cleanup of all orphaned questions and answers (no valid template reference)",
    "Timeout": 600,
    "MemorySize": 256,
    "Environment": {
        "Variables": {
            "MCQ_TABLE": "MCQQuestions",
            "ANSWER_TABLE": "MCQAnswers",
            "TEMPLATE_TABLE": "template"
        }
    }
}
