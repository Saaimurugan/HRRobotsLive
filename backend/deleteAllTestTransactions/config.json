{
    "FunctionName": "deleteAllTestTransactions",
    "Runtime": "python3.12",
    "Role": "arn:aws:iam::850995535850:role/dynamo-db-role",
    "Handler": "lambda_function.lambda_handler",
    "Description": "Deletes all records from testTransactions table and associated photos from S3",
    "Timeout": 900,
    "MemorySize": 512,
    "Environment": {
        "Variables": {
            "TEST_TRANSACTIONS_TABLE": "testTransactions",
            "CANDIDATE_PHOTO_TABLE": "candidatePhoto",
            "S3_BUCKET": "hrrfiles"
        }
    }
}
