{
    "FunctionName": "candidateApply",
    "FunctionArn": "arn:aws:lambda:us-east-1:850995535850:function:candidateApply",
    "Runtime": "python3.12",
    "Role": "arn:aws:iam::850995535850:role/dynamo-db-role",
    "Handler": "lambda_function.lambda_handler",
    "Description": "Handles candidate job applications: saves to DynamoDB, runs AI profiler, creates test, sends email",
    "Timeout": 90,
